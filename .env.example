# Local fallback can stay SQLite. On Vercel, replace with the Neon connection string.
DATABASE_URL=sqlite:///subscriptions.db

# Resend
RESEND_API_KEY=re_your_api_key
# For production, use a sender on a domain you verified in Resend.
# Example: SubTrack <reminders@yourdomain.com>
RESEND_FROM_EMAIL=SubTrack <onboarding@resend.dev>

# Use a long random secret, at least 16 characters.
CRON_SECRET=replace_with_a_long_random_secret
